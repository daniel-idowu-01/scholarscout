# ═══════════════════════════════════════════════════
# ScholarScout Environment Configuration
# Copy to .env and fill in real values
# NEVER commit .env to version control
# ═══════════════════════════════════════════════════

# ── Application ──────────────────────────────────
APP_ENV=development                          # development | staging | production
APP_DEBUG=true
APP_SECRET_KEY=change-me-to-a-secure-random-string-min-64-chars
APP_ALLOWED_HOSTS=["localhost","127.0.0.1"]
APP_CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]
APP_VERSION=0.1.0

# ── API ──────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
API_PREFIX=/api
API_V1_PREFIX=/api/v1
API_DOCS_URL=/api/docs
API_REDOC_URL=/api/redoc

# ── Database ─────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://scholarscout:scholarscout@localhost:5432/scholarscout
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=40
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=3600
DATABASE_ECHO=false

# Sync URL for Alembic migrations
DATABASE_SYNC_URL=postgresql+psycopg2://scholarscout:scholarscout@localhost:5432/scholarscout

# Read replica (optional, falls back to primary)
DATABASE_READ_REPLICA_URL=

# ── Redis ─────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_CELERY_URL=redis://localhost:6379/1
REDIS_CACHE_URL=redis://localhost:6379/2
REDIS_STREAMS_URL=redis://localhost:6379/3
REDIS_MAX_CONNECTIONS=50
REDIS_SOCKET_TIMEOUT=5
REDIS_DECODE_RESPONSES=true

# ── Celery ────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CELERY_TASK_SERIALIZER=json
CELERY_RESULT_SERIALIZER=json
CELERY_ACCEPT_CONTENT=["json"]
CELERY_TIMEZONE=UTC
CELERY_TASK_TRACK_STARTED=true
CELERY_TASK_TIME_LIMIT=3600
CELERY_TASK_SOFT_TIME_LIMIT=3300
CELERY_WORKER_PREFETCH_MULTIPLIER=1
CELERY_WORKER_MAX_TASKS_PER_CHILD=1000

# ── Object Storage ───────────────────────────────
STORAGE_BACKEND=minio                        # minio | s3
STORAGE_ENDPOINT_URL=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_REGION=us-east-1
STORAGE_BUCKET_SNAPSHOTS=scholarscout-snapshots
STORAGE_BUCKET_ASSETS=scholarscout-assets
STORAGE_BUCKET_EXPORTS=scholarscout-exports
STORAGE_USE_SSL=false

# ── OpenSearch ───────────────────────────────────
OPENSEARCH_URL=https://localhost:9200
OPENSEARCH_USERNAME=admin
OPENSEARCH_PASSWORD=admin
OPENSEARCH_VERIFY_CERTS=false
OPENSEARCH_INDEX_OPPORTUNITIES=scholarscout-opportunities
OPENSEARCH_INDEX_UNIVERSITIES=scholarscout-universities
OPENSEARCH_SHARDS=3
OPENSEARCH_REPLICAS=1

# ── Auth ─────────────────────────────────────────
JWT_SECRET_KEY=change-me-jwt-secret-min-64-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=

# ── LLM Providers ────────────────────────────────
LLM_DEFAULT_PROVIDER=anthropic              # openai | anthropic | huggingface | gemini | local
LLM_MAX_TOKENS_PER_CALL=4096
LLM_MONTHLY_BUDGET_USD=500.0

OPENAI_API_KEY=
OPENAI_DEFAULT_MODEL=gpt-4o-mini
OPENAI_EXTRACTION_MODEL=gpt-4o

ANTHROPIC_API_KEY=
ANTHROPIC_DEFAULT_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_EXTRACTION_MODEL=claude-sonnet-4-6

HUGGINGFACE_API_KEY=
HUGGINGFACE_DEFAULT_MODEL=Qwen/Qwen2.5-7B-Instruct

GEMINI_API_KEY=
GEMINI_DEFAULT_MODEL=gemini-1.5-flash

# ── Crawler ──────────────────────────────────────
CRAWLER_DEFAULT_CONCURRENCY=5               # concurrent requests per domain
CRAWLER_DEFAULT_DELAY_SECONDS=2.0           # politeness delay between requests
CRAWLER_REQUEST_TIMEOUT_SECONDS=30
CRAWLER_MAX_RETRIES=3
CRAWLER_USER_AGENT=ScholarScoutBot/1.0 (+https://scholarscout.io/bot)
CRAWLER_RESPECT_ROBOTS_TXT=true
CRAWLER_MAX_PAGE_SIZE_MB=10
CRAWLER_PLAYWRIGHT_POOL_SIZE=5

# Queue priorities (higher = more urgent)
CRAWLER_PRIORITY_NEW_UNIVERSITY=100
CRAWLER_PRIORITY_HIGH_RANKED=80
CRAWLER_PRIORITY_SCHEDULED=50
CRAWLER_PRIORITY_REFRESH=30
CRAWLER_PRIORITY_DISCOVERY=20

# ── Email ────────────────────────────────────────
EMAIL_BACKEND=smtp                          # smtp | sendgrid | ses
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=false
SMTP_FROM_EMAIL=noreply@scholarscout.io
SMTP_FROM_NAME=ScholarScout

SENDGRID_API_KEY=
SES_REGION=us-east-1

# ── Observability ────────────────────────────────
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_ENVIRONMENT=development

OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=scholarscout
OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=prometheus

PROMETHEUS_PORT=9090
LOG_LEVEL=INFO
LOG_FORMAT=json                             # json | console

# ── Feature Flags ────────────────────────────────
FEATURE_LLM_EXTRACTION=true
FEATURE_SEMANTIC_SEARCH=false
FEATURE_NOTIFICATIONS_EMAIL=true
FEATURE_NOTIFICATIONS_TELEGRAM=false
FEATURE_RECOMMENDATIONS=true
